<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="local-only-test-key-000000000000"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="AI_PROVIDER" value="fake" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="CORS_ALLOWED_ORIGINS" value="http://localhost:3000" force="true"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="REVERB_APP_ID" value="refund-system-test"/>
        <env name="REVERB_APP_KEY" value="refund-system-test-key"/>
        <env name="REVERB_APP_SECRET" value="refund-system-test-secret"/>
        <env name="REVERB_HOST" value="localhost"/>
        <env name="REVERB_PORT" value="8080"/>
        <env name="REVERB_SCHEME" value="http"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SESSION_COOKIE" value="refund_system_session" force="true"/>
        <env name="SESSION_SAME_SITE" value="lax" force="true"/>
        <env name="SESSION_SECURE_COOKIE" value="false" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:3000,127.0.0.1:3000" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
