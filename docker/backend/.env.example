# Backend and supporting local service defaults. Edit docker/backend/.env locally.
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_FORWARD_PORT=6380
REVERB_FORWARD_PORT=8080

APP_NAME="AI Refund System"
APP_ENV=local
APP_KEY=local-only-app-key-0000000000000
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

LOG_CHANNEL=stderr

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=refund_system
DB_USERNAME=refund_app
DB_PASSWORD=refund-app-local-only
DB_SSLMODE=disable

POSTGRES_DB=refund_system
POSTGRES_USER=refund_app
POSTGRES_PASSWORD=refund-app-local-only

SESSION_DRIVER=database
SESSION_COOKIE=refund_system_session
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
CACHE_PREFIX=refund_system_cache
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=refund-system-local
REVERB_APP_KEY=refund-system-local-key
REVERB_APP_SECRET=refund-system-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

AI_PROVIDER=gemini
AI_MAX_RESPONSE_BYTES=32768
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

SIMULATED_PAYMENT_FORCE_FAILURE=false
